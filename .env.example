# ===== 실행 모드 =====
# real | mock (계좌별 accounts.yaml 의 mode 값이 우선되며, 이 값은 계좌에 mode 미지정 시의 기본값입니다)
KIWOOM_ENV=mock
# Safety default: run balance/price monitoring only. Set true only after
# validating the strategy and deliberately authorizing automated orders.
AUTO_TRADING_ENABLED=false
# After a broker-confirmed BUY fill, wait for one reconciliation window before
# allowing the next grid BUY. SELL orders are intentionally not delayed.
GRID_BUY_REENTRY_DELAY_SEC=5
# Separate US mock-order gate. Keep false until the US paper account's quote,
# balance, and execution response fields have been checked in the dashboard.
US_PAPER_ORDER_SUBMISSION_ENABLED=false
US_EXTENDED_HOURS_ENABLED=false
KIWOOM_FX_REFRESH_SEC=60

# ===== 계좌 A: 해외주식(US) 실계좌 =====
ACCOUNT_A_NO=0000000000
ACCOUNT_A_APPKEY=changeme        # 키움 "실전투자" 앱키
ACCOUNT_A_SECRETKEY=changeme

# ===== 계좌 B: 해외주식(US) 모의투자 =====
ACCOUNT_B_NO=1111111111
ACCOUNT_B_APPKEY=changeme        # 키움 "모의투자" 앱키 (실전 앱키와 다른 값!)
ACCOUNT_B_SECRETKEY=changeme

# ===== 계좌 C: 국내주식(KRX) 실계좌 =====
ACCOUNT_C_NO=2222222222
ACCOUNT_C_APPKEY=changeme        # 키움 "실전투자" 앱키
ACCOUNT_C_SECRETKEY=changeme

# ===== 계좌 D: 국내주식(KRX) 모의투자 =====
ACCOUNT_D_NO=3333333333
ACCOUNT_D_APPKEY=changeme        # 키움 "모의투자" 앱키 (실전 앱키와 다른 값!)
ACCOUNT_D_SECRETKEY=changeme

# accounts.yaml 에 정의하지 않은 계좌의 환경변수는 없어도 됩니다 (2계좌만 쓰면 A/B만 채우면 됩니다).

# ===== 텔레그램 =====
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme
# 주문 실행 전 텔레그램 승인 필요 여부 (true/false)
# Retained only for backward-compatible .env files. Order approval is no longer used.
TELEGRAM_APPROVAL_REQUIRED=false

# ===== 디스코드 (선택) =====
DISCORD_WEBHOOK_URL=

# ===== 구글 시트 =====
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google_service_account.json
GOOGLE_SHEET_ID=changeme
GOOGLE_DRIVE_FOLDER_ID=changeme

# ===== 스케줄 =====
REPORT_INTERVAL_MINUTES=5
SPLIT_CHECK_TIME=08:00
# Broker-balance synchronization interval in seconds (15 matches the engine poll).
BALANCE_RECONCILE_SEC=15

# ===== 리스크 관리 (계좌별 상세값은 config/strategy_config*.json 의 risk 항목을 우선 사용) =====
MAX_POSITION_PER_SYMBOL_AMOUNT=10000
MAX_DAILY_LOSS_PCT=5

# ===== 실시간 시세 (src/core/realtime_feed.py) =====
# auto: WebSocket 우선 + REST 폴백(권장) | ws: WebSocket 전용 | rest: REST 폴링 전용
PRICE_FEED_MODE=auto
# WS 캐시가 이 값(초)보다 오래되면 auto 모드에서 REST로 폴백
KIWOOM_PRICE_MAX_STALENESS_SEC=20
# ws 전용 모드에서 최초 체결 수신을 기다리는 최대 시간(초)
KIWOOM_WS_FIRST_TICK_WAIT_SEC=5
# WS 연결 유지용 PING 전송 주기(초)
KIWOOM_WS_PING_INTERVAL_SEC=30
# ⚠️ 아래 3개는 원본 명세서 대조 검증 전까지는 기본값(추정치)입니다. 실제 명세서 확인 후 필요 시 교체하세요.
# KIWOOM_WS_URL_REAL=wss://api.kiwoom.com:10000/api/dostk/websocket
# KIWOOM_WS_URL_MOCK=wss://mockapi.kiwoom.com:10000/api/dostk/websocket
# KIWOOM_REALTIME_TYPE=0B
# KIWOOM_REALTIME_PRICE_FID=10
